# ================================================================
# Intelligent SQL AI Agent — environment TEMPLATE (safe to commit)
# Copy this file to .env and fill in the values marked <REQUIRED>.
# NEVER put real API keys in this file — they belong in .env only.
# ================================================================

# --- LLM (OpenAI) ---
LLM_PROVIDER=openai
LLM_API_KEY=<REQUIRED — sk-proj-... from platform.openai.com/api-keys>
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# --- Postgres (defaults work as-is for local docker-compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=shop_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_READONLY_ROLE=agent_readonly
DB_READONLY_PASSWORD=agent_readonly_pw

# --- Chat store (MongoDB, async Motor from FastAPI) ---
MONGO_URI=mongodb://mongodb:27017/sql_agent

# --- Guardrails / limits ---
SAFE_INLINE_LIMIT=250
HARD_ROW_CEILING=50000
OVERFLOW_SAMPLE_SIZE=20
QUERY_TIMEOUT_MS=5000
MAX_RETRIES=3
MAX_SUBQUESTIONS=5

# --- RAG ---
RAG_ENABLED=true
RAG_TOP_K_EXAMPLES=3
RAG_TOP_K_COLUMN_DOCS=5

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=<REQUIRED — pk-lf-... from cloud.langfuse.com>
LANGFUSE_SECRET_KEY=<REQUIRED — sk-lf-... from cloud.langfuse.com>
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=<REQUIRED for trace deep-links — from Langfuse project URL>

# --- Observability (LangSmith — optional; enables LangGraph Studio + native LangGraph traces) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=<OPTIONAL — lsv2_pt_... from smith.langchain.com>
LANGCHAIN_PROJECT=sql-agent

# --- Agent framework (langgraph | adk) ---
FRAMEWORK=langgraph

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
